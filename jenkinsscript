pipeline{
    agent {
        node {
            label 'oneplus'
        }
    }
    environment {
        scannerHome = tool 'mysonar'
    }
    stages {
        stage("Code"){
            steps {
                git 'https://github.com/Pavankumar49280/python-code-library-app.git'
            }
        }
        stage("CQA"){
            steps{
            withSonarQubeEnv('mysonar') {
             sh "${scannerHome}/bin/sonar-scanner -Dsonar.projectKey=myproject"
             }
            }
        }
        stage("Qualitygate") {
            steps {
                waitForQualityGate abortPipeline: false, credentialsId: 'sonar_cred'
            }
        }
        stage("Build"){
            steps {
                sh '''
                docker build -t db database
                docker build -t authimage auth
                docker build -t bookimage book
                docker build -t borrowimage borrow
                docker build -t frontimage .
                '''
            }
        }
        stage("Scan"){
            steps {
                sh '''
                trivy image db
                trivy image authimage
                trivy image bookimage
                trivy image borrowimage
                trivy image frontimage
                '''
            }
        }
        stage("Registry") {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker_cred') {
                sh '''
                docker tag db kumar49/secondproject:db
                docker tag authimage kumar49/secondproject:authimage
                docker tag bookimage kumar49/secondproject:bookimage
                docker tag borrowimage kumar49/secondproject:borrowimage
                docker tag frontimage kumar49/secondproject:frontimage
                docker push kumar49/secondproject:db
                docker push kumar49/secondproject:authimage
                docker push kumar49/secondproject:bookimage
                docker push kumar49/secondproject:borrowimage
                docker push kumar49/secondproject:frontimage
                '''
                    }
                }
            }
        }
        stage ("Deploy"){
            steps {
                sh "docker stack deploy pavan --compose-file=compose.yml"
            }
        }
    }
post {
    always {
    mail to: 'pavan15ndlm@gmail.com',
    subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
    body: "*${currentBuild.currentResult}:* Job ${env.JOB_NAME} \n build ${env.BUILD_NUMBER} \n More info at: ${env.BUILD_URL}"
    }
    }
